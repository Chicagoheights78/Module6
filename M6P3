# M6P3
term = input("Enter CD Term (e.g., 10, 5): ")
principal = int(input("Enter principal amount: "))
if principal > 100000 and term == "5":    
    interest_rate = .06
else:
     if principal >= 50000 and principal <= 100000 and term == "10":
         interest_rate = .05
     else:
         if principal >= 50000 and principal <= 100000 and term == "5":
             interest_rate = .04
         else:
             interest_rate = .02
year1interest = principal * interest_rate
print(f"Principal Amount:                  ${principal:10.2f}")
print(f"Interest Rate:                      {interest_rate * 100:10.2f}%")
print(f"Total year one interest expense:   ${year1interest:10.2f}")