part_number = input("Enter the part number (e.g., 10, 55, 99, 80): ")
quantity = int(input("Enter the quantity: "))
if part_number == "10" or part_number == "55":    
    unit_cost = 1.00
else:
     if part_number == "80" or part_number == "70":    
         unit_cost = 3.00
     else:
         if part_number == "99":
             unit_cost = 2.00
         else:
             unit_cost = 5.00
total_cost = quantity * unit_cost
print(f"Part number: {part_number}")
print(f"Cost per unit:     ${unit_cost:10.2f}")
print(f"Total cost:          ${total_cost:10.2f}")