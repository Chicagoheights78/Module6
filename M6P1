# M6P1
quantity = int(input("Enter the quantity of widgets: "))
if quantity > 10000:
    unit_price = 10.00
else:
     if quantity >= 5000:
         unit_price = 20.00
     else:
         unit_price = 30.00

extended_price = quantity * unit_price
tax = extended_price * 0.07
total = extended_price + tax
print(f"Extended Price: ${extended_price:10.2f}")
print(f"Tax Amount:     ${tax:10.2f}")
print(f"Total:          ${total:10.2f}")